# Copy to .env and adjust.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vult_store
# Where the storefront is served from (comma-separated). file:// pages send "null".
STORE_CORS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000
# Change both secrets before going live.
JWT_SECRET=change-me
COOKIE_SECRET=change-me
# Optional: create this admin login on start if it does not exist (used on Railway).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
