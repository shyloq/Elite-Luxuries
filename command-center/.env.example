# Supabase project: Settings > API. The service role key stays on the server; never put it in the site.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The password for the command center at /command, and a long random string that signs its login cookie.
COMMAND_PASSWORD=
SESSION_SECRET=

# Sites allowed to read the store content and add to the waitlist (comma-separated, no trailing slash).
STORE_ORIGINS=https://shyloq.github.io,http://localhost:8000
